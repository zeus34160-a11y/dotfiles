* {
    bg: #1e1633;
    fg: #e9ddff;
    mauve: #cba6f7;
    pink: #f5c2e7;
    plum: #49345f;
    disabled: #796493;
}

window {
    width: 650px;
    border: 3px;
    border-color: @mauve;
    border-radius: 20px;
    background-color: @bg;
    padding: 20px;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 16px;
}

inputbar {
    background-color: @plum;
    border-radius: 12px;
    padding: 12px;
    children: [ prompt, entry ];
    spacing: 10px;
}

prompt {
    text-color: @mauve;
}

entry {
    text-color: @fg;
    placeholder: "Search applications...";
    placeholder-color: @disabled;
}

listview {
    columns: 1;
    lines: 7;
    fixed-height: true;
    background-color: transparent;
    spacing: 6px;
}

element {
    padding: 10px;
    border-radius: 10px;
    background-color: transparent;
    text-color: @fg;
}

element selected {
    background-color: @plum;
    text-color: @pink;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}

element-icon {
    size: 28px;
    background-color: transparent;
}


inputbar {
    background-color: @plum;
    text-color: @fg;
    border-radius: 12px;
    padding: 12px;
    children: [ prompt, entry ];
    spacing: 10px;
}

prompt {
    background-color: transparent;
    text-color: @mauve;
}

entry {
    background-color: transparent;
    text-color: @fg;
    placeholder: "Search applications...";
    placeholder-color: @disabled;
}

textbox {
    background-color: transparent;
    text-color: @fg;
}

element-text {
    background-color: transparent;
    text-color: inherit;
}
