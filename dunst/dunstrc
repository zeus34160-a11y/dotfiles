[global]
monitor = 0
follow = mouse
width = 350
height = 150
origin = top-right
offset = 20x20
gap_size = 8
padding = 12
horizontal_padding = 16
frame_width = 2
corner_radius = 12
font = JetBrainsMono Nerd Font Mono 11
format = "<b>%s</b>\n%b"
alignment = left
markup = full
word_wrap = yes
mouse_left_click = close_current
mouse_middle_click = do_action, close_current
mouse_right_click = close_all

[urgency_low]
background = "#1e1e2e"
foreground = "#a6adc8"
frame_color = "#45475a"
timeout = 5

[urgency_normal]
background = "#f5c2e7"
foreground = "#1e1e2e"
frame_color = "#f5c2e7"
timeout = 8

[urgency_critical]
background = "#1e1e2e"
foreground = "#cdd6f4"
frame_color = "#f38ba8"
timeout = 0

[play_sound]
summary = "*"
script = /home/italy/.config/dunst/sound.sh
